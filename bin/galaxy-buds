    {"name": "buds4", "charging": True, "ids": (355, 356), "match": ("Buds4",),
     "uuid": SPP_NEW, "fw_model": "Buds4", "noise_ack_receipt": True,
     "modes": ("off", "anc", "ambient"), "noise": ("controls", 12), "touch": ("bits7", 10),
     "seamless": (19, 0), "one_bud_noise": (28, 0), "spatial": (35, 0)},

    {"name": "buds3", "charging": True, "ids": (333, 334), "match": ("Buds3",),
     "uuid": SPP_NEW, "fw_model": "Buds3",
     "modes": ("off", "anc", "ambient"), "noise": ("controls", 12), "touch": ("bits7", 10),
     "seamless": (19, 0), "one_bud_noise": (28, 0), "spatial": (35, 0)},
