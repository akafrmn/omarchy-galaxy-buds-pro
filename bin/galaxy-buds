#!/usr/bin/python3
"""Galaxy Buds control daemon for the Omarchy shell.

Speaks Samsung's SPP protocol over an RFCOMM socket that BlueZ hands us through
the Profile1 API, the same path GalaxyBudsClient takes on Linux. Reads commands
as JSON lines on stdin, writes the earbud state as JSON lines on stdout.

Only one process can hold the SPP link, so opening the GalaxyBudsClient GUI
while this runs will take the connection away from one of the two.

Needs the system python: dbus-python and PyGObject live there, not in brew's.
"""

import json
import os
import re
import signal
import struct
import subprocess
import sys
import threading
import time

DEBUG = bool(os.environ.get("GALAXY_BUDS_DEBUG"))

# Each generation answers on its own service. The 1101 one is plain SPP, which
# plenty of unrelated devices also advertise, so a device only counts as
# earbuds when it carries the new service or its name matches a known model.
SPP_NEW = "2e73a4ad-332d-41fc-90e2-16bef06523f2"
SPP_STANDARD = "00001101-0000-1000-8000-00805f9b34fb"
SPP_LEGACY = "00001102-0000-1000-8000-00805f9b34fd"

# The device id is the tail of this vendor UUID. Only models from Buds2 on
# publish it; older ones are identified by name.
DEVICE_ID_UUID_PREFIX = "d908aab5-7a90-4cbe-8641-86a553db"

SOM, EOM = 0xFD, 0xDD
LEGACY_SOM, LEGACY_EOM = 0xFE, 0xEE

MSG_ACK = 66
MSG_STATUS = 96
MSG_EXTENDED_STATUS = 97
MSG_NOISE_CONTROLS_UPDATE = 119
MSG_NOISE_CONTROLS = 120
MSG_SET_SPATIAL_AUDIO = 124
MSG_SET_AMBIENT_MODE = 128
MSG_AMBIENT_MODE_UPDATED = 129
MSG_EQUALIZER = 134
MSG_LOCK_TOUCHPAD = 144
MSG_SET_NOISE_REDUCTION = 152
MSG_NOISE_REDUCTION_MODE_UPDATE = 155
# Find My Earbuds. 166 (FIND_MY_EARBUDS_ON_WEARING_START, ring while worn) is
# deliberately never sent.
MSG_FIND_START = 160
MSG_FIND_STOP = 161            # we send it to stop; the earbuds send it when they stop
MSG_MUTE_EARBUD = 162          # [left, right], 1 = muted
MSG_MUTE_EARBUD_UPDATED = 163  # [left, right] from the earbuds; never echoed back
MSG_SET_SEAMLESS_CONNECTION = 175
MSG_VERSION_INFO_LONG = 104
MSG_FOTA_RESULT = 185
MSG_FOTA_OPEN = 187
MSG_FOTA_CONTROL = 188
MSG_FOTA_DOWNLOAD_DATA = 189
MSG_FOTA_UPDATE = 190
FOTA_MESSAGES = (MSG_FOTA_RESULT, MSG_FOTA_OPEN, MSG_FOTA_CONTROL, MSG_FOTA_DOWNLOAD_DATA, MSG_FOTA_UPDATE)

# Header flags. The host marks its answers to the earbuds' firmware requests
# as responses, and the data chunks as fragments too.
FLAG_RESPONSE = 0x1000
FLAG_FRAGMENT = 0x2000

# ConnectProfile errors meaning BlueZ has no registration of ours any more.
PROFILE_GONE_ERRORS = ("profile-unavailable", "InvalidArguments", "ServiceUnknown", "UnknownObject")
# How long a ConnectProfile that "worked" may go without handing us the socket
# before BlueZ's idea of the link counts as stale.
STALE_LINK_MS = 3000

MODES = {"off": 0, "anc": 1, "ambient": 2}
MODE_NAMES = {v: k for k, v in MODES.items()}

# Equalizer presets as the EQUALIZER message and the extended status carry
# them. 6 is the custom curve another app (Galaxy Wearable) set: shown, never
# sent, since its bands live in that app. Captured on a Buds3 Pro, and what
# NebulaBuds and OtoControl decode; GalaxyBudsClient says 7, from one
# uncaptured Buds4 Pro change. Anything else reads "unknown", not a guess.
EQ_PRESETS = {"off": 0, "bass": 1, "soft": 2, "dynamic": 3, "clear": 4, "treble": 5}
EQ_CUSTOM = 6
EQ_NAMES = {**{v: k for k, v in EQ_PRESETS.items()}, EQ_CUSTOM: "custom"}

# What actually differs between models. Everything else -- framing, CRC, the
# commands, the battery messages -- is shared, so adding a model is a row here.
#
#   noise:    (kind, offset in the extended status)
#             "controls" = one byte with three modes (Buds Pro and newer)
#             "ambient"  = ambient sound on/off (Buds, Buds+, no ANC at all)
#             "anc"      = noise cancelling on/off (Buds Live, no ambient mode)
#   touch:    (shape, offset); "bits7" models send seven booleans back
#   seamless: (offset, first firmware revision that reports it)
#   spatial:  same, or None when the model has no 360 Audio
#   eq:       same, for the equalizer preset; None where it is not read (the
#             original Buds use another encoding)
#
# Order matters: name matching walks this list, so "Buds2 Pro" has to come
# before "Buds2".
PROFILES = [
